# În Termen — variabile de mediu
# Copiază fișierul în .env.local și completează valorile. Nu urca niciodată .env.local în git.

# --- Supabase (obligatoriu) -------------------------------------------------
# Supabase Dashboard → Project Settings → API (sau `npx supabase status` local).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Cheia publică „anon”: sigură în browser, accesul este limitat de RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Adresa publică a aplicației (linkurile din e-mailuri, redirecturi).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dimensiunea maximă a unui fișier, în MB. Trebuie să fie <= limita bucket-ului (10 MB în migrare).
NEXT_PUBLIC_MAX_UPLOAD_MB=10

# --- Doar pe server ---------------------------------------------------------
# Cheia service-role OCOLEȘTE RLS. Folosită doar de jobul /api/cron/reminders.
# Nu o prefixa niciodată cu NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Secret pentru /api/cron/reminders (Vercel Cron îl trimite automat ca „Authorization: Bearer …”).
# Generează unul: openssl rand -hex 32
CRON_SECRET=

# --- E-mail (opțional, dezactivat implicit) ---------------------------------
# Fără aceste două valori, aplicația afișează „Notificările prin e-mail nu sunt configurate încă.”
RESEND_API_KEY=
EMAIL_FROM="În Termen <remindere@domeniul-tau.md>"

# --- OCR (opțional, dezactivat implicit) ------------------------------------
# Fără furnizor, „Extrage date din document (beta)” arată doar o simulare transparentă.
# Valori acceptate: google_vision
OCR_PROVIDER=
GOOGLE_VISION_API_KEY=
