// /etc/apt/apt.conf.d/52cafenea-unattended-upgrades — completări la configurația Ubuntu.
// Implicit se instalează doar actualizările de securitate Ubuntu (inclusiv PostgreSQL 16).
// Node.js (NodeSource) și Caddy se actualizează la verificarea lunară (deploy/README.md).

// Un nucleu nou cere repornirea serverului: se face noaptea, când cafenelele sunt închise.
// Tabletele lucrează offline cele ~2 minute și trimit apoi tot ce s-a adunat.
Unattended-Upgrade::Automatic-Reboot "true";
Unattended-Upgrade::Automatic-Reboot-Time "04:30";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
