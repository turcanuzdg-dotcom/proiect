# /etc/cafenea/verificari.env — verificările de la 5 minute (verificari.sh).
# instaleaza.sh creează fișierul din acest model (root:root, mod 600); după completare rulați din nou
# instaleaza.sh, care pornește timerul.

# Adresa de anunț a verificării „cafenea-verificari” din healthchecks.io (perioadă 5 min, toleranță 10 min).
PING_URL_VERIFICARI=https://hc-ping.com/COMPLETATI

# Alertă când discul trece de acest procent.
PRAG_DISC=80

# Programul cafenelelor (ore întregi, ora Chișinăului), în care o tabletă tăcută e o problemă.
ORE_LUCRU=8-22
ORE_FARA_SINCRONIZARE=2
