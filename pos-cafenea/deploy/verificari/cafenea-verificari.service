# Verificările de la 5 minute (server, disc, ceas, erori de sincronizare, tablete tăcute).
# Instalat de instaleaza.sh în /etc/systemd/system/; pornit de cafenea-verificari.timer.

[Unit]
Description=Verificări POS (rezultatul la healthchecks.io)
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=cafenea-backup
Group=cafenea-backup
EnvironmentFile=/etc/cafenea/verificari.env
Environment=PGHOST=/run/postgresql PGUSER=cafenea_citire PGDATABASE=cafenea
ExecStart=/usr/local/lib/cafenea/verificari.sh
TimeoutStartSec=2min
# Un eșec al verificării e deja raportat la healthchecks.io; nu e nevoie ca systemd să-l mai trateze.
SuccessExitStatus=1

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
MemoryMax=128M
