# /etc/cafenea/server.env — configurația serverului POS în producție.
#
# instaleaza.sh creează fișierul din acest model (o singură dată; nu-l suprascrie la rulările
# următoare) și generează parola rolului de migrații. Restul îl completați de mână:
#   sudo nano /etc/cafenea/server.env
#   sudo systemctl restart cafenea
#
# Drepturi: root:root, mod 600 (sudo chmod 600 /etc/cafenea/server.env). systemd îl citește ca root
# înainte să pornească serviciul, deci utilizatorul „cafenea” nu are nevoie să-l poată citi.
# Fișierul NU intră în git și nu se trimite pe e-mail sau chat.
#
# Format: CHEIE=valoare, câte una pe rând, fără spații în jurul lui „=”. O valoare cu spații sau cu
# caractere speciale ($ ` " \ #) se pune între ghilimele simple: ADMIN_PAROLA='o parolă lungă'.
#
# Stau în cafenea.service și nu trebuie repetate aici: NODE_ENV=production, HOST=127.0.0.1,
# PORT=3000, UV_THREADPOOL_SIZE=8.

# ---- Baza de date ----
# Rolul aplicației: poate doar citi și scrie date (SELECT/INSERT/UPDATE/DELETE), nu poate schimba
# schema și nu poate goli tabele. Fără parolă: PostgreSQL recunoaște utilizatorul de sistem „cafenea”
# prin socketul local (autentificare „peer”), deci nu există nicio parolă care să se poată scurge.
DATABASE_URL=postgresql://cafenea_app@/cafenea?host=/run/postgresql

# Rolul proprietar al schemei, folosit doar ca să aplice migrațiile noi (server/migrari) după o
# actualizare; cererile obișnuite merg tot pe rolul de mai sus. Parola o generează instaleaza.sh
# (litere și cifre, deci nu trebuie codificată în adresă).
DATABASE_URL_MIGRARI=postgresql://cafenea_migrari:PAROLA_GENERATA_DE_INSTALEAZA@/cafenea?host=/run/postgresql

# ---- Administratorul ----
# Doar pentru PRIMA pornire, cât baza nu are niciun administrator: serverul creează contul din
# aceste valori. Imediat după ce v-ați autentificat în panou, ștergeți ADMIN_PAROLA de aici și
# reporniți serviciul (altfel parola rămâne lizibilă în fișier și în mediul procesului).
# Parola: minimum 12 caractere, generată (de ex. din managerul de parole), nu refolosită.
ADMIN_LOGIN=admin
ADMIN_PAROLA=

# ---- Terminalul fiscal (POSLink / Intelectsoft) ----
# Cheia API din cabinetul POSLink. Rămâne doar pe server: tabletele nu o primesc niciodată.
POSLINK_API_KEY=
# Doar dacă Intelectsoft vă dă altă adresă (de ex. mediul de test); implicit cea de producție.
#POSLINK_URL=https://poslink.eservicii.md/POSLink

# ---- Rețea ----
# Ce proxy are voie să spună adresa reală a clientului (antetul X-Forwarded-For): doar Caddy, de pe
# aceeași mașină. Aceeași valoare e și în cafenea.service. Se schimbă doar dacă pui un CDN în față.
TRUST_PROXY=loopback

# ---- Jurnal ----
# 1 = fiecare cerere în journald (metodă, adresă fără parametri, IP), păstrat 30 de zile; 0 = doar erori.
JURNAL=1
