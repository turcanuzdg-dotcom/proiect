# /etc/cafenea/backup.env — unde și cum pleacă copiile de siguranță.
# instaleaza.sh creează fișierul din acest model (root:root, mod 600). Completați valorile marcate
# COMPLETATI, apoi: sudo bash /opt/cafenea/curent/deploy/instaleaza.sh (pornește timerul).
# Pașii de creare a bucket-ului și a cheilor sunt în deploy/README.md, „Copii de siguranță”.

# Remote-ul rclone „copii” + numele bucket-ului (opțional și un prefix: copii:bucket/cafenea).
COPII_DESTINATIE=copii:COMPLETATI-numele-bucketului

# Conexiunea S3 a remote-ului „copii” (rclone o citește din variabile, nu din rclone.conf).
# Exemplul e pentru Backblaze B2, regiunea UE (Amsterdam); pentru alt furnizor S3 schimbați
# ENDPOINT și REGION. Cheia trebuie să NU aibă drept de ștergere (vezi README).
RCLONE_CONFIG_COPII_TYPE=s3
RCLONE_CONFIG_COPII_PROVIDER=Other
RCLONE_CONFIG_COPII_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
RCLONE_CONFIG_COPII_REGION=eu-central-003
RCLONE_CONFIG_COPII_ACCESS_KEY_ID=COMPLETATI
RCLONE_CONFIG_COPII_SECRET_ACCESS_KEY=COMPLETATI
# Bucket-ul există deja; cheia nu are dreptul să creeze bucket-uri.
RCLONE_CONFIG_COPII_NO_CHECK_BUCKET=true

# Fișierul cu cheile publice age (age1...) care pot deschide copiile. Cheile private NU stau aici.
AGE_DESTINATARI=/etc/cafenea/backup-destinatari.txt

# Adresa de anunț healthchecks.io a verificării „cafenea-backup” (perioadă 15 min, toleranță 30 min).
PING_URL=https://hc-ping.com/COMPLETATI
