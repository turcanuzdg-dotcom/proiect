{
  "name": "pos-cafenea",
  "private": true,
  "type": "module",
  "workspaces": ["shared", "server", "web", "punte"],
  "scripts": {
    "dev": "npm run dev -w server & npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "test": "vitest run",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p web && tsc -p punte && tsc -p simulare",
    "simulare": "tsx simulare/genereaza-date.ts && vite build --config simulare/vite.config.ts",
    "simulare:site": "SIMULARE_SITE=https://turcanuzdg-dotcom.github.io/proiect/ vite build --config simulare/vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.0",
    "vitest": "^4.1.12"
  }
}
